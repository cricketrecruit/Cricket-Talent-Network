# Copy to .env for local dev. Set the same values in Vercel Project Settings > Environment Variables.

# Client-visible (Vite exposes VITE_* to the browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
# Production domain, used to build absolute URLs in sitemap.xml. Leave empty until the domain is set.
VITE_SITE_URL=

# Server-only (SSR + server functions)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Resend API key (HTTP API, not the SMTP credentials) - used to email admins when a new player signs up.
RESEND_API_KEY=your-resend-api-key
